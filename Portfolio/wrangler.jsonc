{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "mariuwl-portfolio",

  "main": "src/worker.tsx",

  "compatibility_date": "2025-08-21",

  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "vars": {},

  "routes": [
    {
      "pattern": "mariuwl.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mariuwl.com",
      "custom_domain": true
    }
  ]
}